# ── Anthropic ──────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Azure AD / Microsoft Graph ─────────────────────────────────────────────────
# Register a new app at https://portal.azure.com → Azure Active Directory
# → App registrations → New registration
#
# Required API permissions (Microsoft Graph):
#   Mail.Read   (Delegated — lets the signed-in user read their own mail)
#
# For interactive (device-code) sign-in, leave CLIENT_SECRET blank.
# For unattended/service-account use, fill CLIENT_SECRET and set AZURE_TENANT_ID.

AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_TENANT_ID=common          # or your tenant ID / domain e.g. contoso.onmicrosoft.com
AZURE_CLIENT_SECRET=            # leave blank for interactive sign-in

# ── Search settings ────────────────────────────────────────────────────────────
DAYS_BACK=30                    # how many days back to search
SEARCH_FOLDERS=Inbox            # comma-separated folder names e.g. Inbox,Finance,Invoices
OUTPUT_DIR=./output             # directory for Excel report and saved PDFs
